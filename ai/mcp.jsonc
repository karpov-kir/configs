// User MCP servers. Edit here, then run ./mcp-sync.sh --agent=claude or --agent=codex.
// A comment has to own its whole line. mcp-sync.sh blanks any line starting with `//`, so a string
// value that starts one gets blanked too. A `//` later in a line survives, and jq won't parse it.
// URLs inside quotes are fine.
{
  "mcpServers": {
    // Only servers that may be named in public belong in this file. It is committed. An internal
    // host, or anything carrying a credential, goes in ai/mcp.private.jsonc, which is gitignored and
    // which mcp-sync.sh reads in the same run — ai/README.md states that policy.


    // Launches a Chrome of its own, on a profile that persists between runs, one per project
    // directory. It isn't a clean room: what I sign into there stays signed in. One browser at a
    // time per profile, so two clients in one project conflict.
    "playwright": {
      "type": "stdio",
      "command": "@CONFIGS@/mcp-env.sh",
      "args": ["mise", "exec", "node@lts", "--", "npx", "-y", "@playwright/mcp"]
    },
    // Drives the Chrome already running on this machine, my everyday profile and my open tabs. It
    // needs Chrome's remote debugging switched on; README.md carries that step and the warning
    // about leaving it on.
    // --autoConnect asks for the connection once per server process.
    "chrome-devtools": {
      "type": "stdio",
      "command": "@CONFIGS@/mcp-env.sh",
      "args": ["mise", "exec", "node@lts", "--", "npx", "-y", "chrome-devtools-mcp", "--autoConnect"]
    }
  }
}
