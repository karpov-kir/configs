#!/usr/bin/env bash
# Refuse a push that carries a name from the owner's private-name list, in any line it adds or any
# commit message it holds. A commit-msg hook reads a message once, and a message amended after it
# or a commit made elsewhere is read here.
#
#   usage: pre-push <remote> <url>   (git calls it, with the refs on stdin. Bootstrap points the
#          checkout's hooks at ai/hooks)
#
# tested by: the Go suite in ai/tools/ai-bootstrap/.
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  base="$remote_sha"
  if [ "$base" = "$zero" ]; then
    # A new branch reads from where it leaves main. With no main it reads from the empty tree, and its
    # first commit is read too.
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || echo 4b825dc642cb6eb9a060e54bf8d69288fbee4904)"
  fi
  "$top/ai/kk-flavor/skills/kk-edit/scripts/voice-check.sh" --private-names "$base..$local_sha" || status=$?
done
exit "$status"
