--- context
The change set touches tests/helpers/ModuleHelper.ts, adding a retry to `loadModule`. The block below was in the file before the change.
--- code
/**
 * Loads a vendor module script into the page.
 * @param name the module's short name, such as `ledger-export` for `vendor-ledger-export.js`
 */
export async function loadModule(name: string): Promise<void> {
  await injectScript(`${MODULE_BASE_URL}/vendor-${name}.js`);
}
