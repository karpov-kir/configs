--- code
export function listPostingCells(): PostingCell[] {
  const cells: PostingCell[] = [];

  Object.values(Account).forEach(account => {
    Object.values(Settlement).forEach(settlement => {
      cells.push({ account, settlement });
    });
  });

  return cells;
}
--- facts
Lists every combination of account and settlement, account-major.
