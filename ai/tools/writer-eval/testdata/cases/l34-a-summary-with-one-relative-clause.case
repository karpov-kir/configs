labelled: 2026-09-30
--- code
export function mismatchOf(statement: Statement, catalog: Catalog): string | undefined {
  const listed = catalog.closingBalance(statement.account);
  if (listed === statement.closingBalance) {
    return undefined;
  }
  return `closing balance ${statement.closingBalance} is not the listed ${listed}`;
}
--- facts
Returns why a statement's closing balance differs from the balance the catalog lists for its account, or undefined when the two match.
