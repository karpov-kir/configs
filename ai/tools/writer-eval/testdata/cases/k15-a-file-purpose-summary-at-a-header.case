--- code
import { LedgerBook, Posting } from './book';

export function readPostings(book: LedgerBook): Posting[] {
  return book.entries.map((entry) => ({ ...book.defaults, ...entry }));
}
--- facts
Reads postings out of a ledger book, following the field inheritance the specification defines.
