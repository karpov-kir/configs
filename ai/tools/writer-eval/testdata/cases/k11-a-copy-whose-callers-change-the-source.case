labelled: 2026-09-21
--- code
export function toEntries(view: LiveEntryView<LedgerEntry>): LedgerEntry[] {
  const entries: LedgerEntry[] = [];
  for (let at = 0; at < view.length; at++) {
    entries.push(view.item(at));
  }
  return entries;
}
--- callers
// tests/helpers/ClosingBookHelper.ts
toEntries(book.periods).forEach((period) => book.removeEntry(period));

// tests/helpers/ClosingBookHelper.ts
toEntries(book.accruals).forEach((accrual) => book.removeEntry(accrual));
--- facts
The returned array is a copy of a LiveEntryView, which stops listing an entry the book has removed.
The copy still holds that entry.
