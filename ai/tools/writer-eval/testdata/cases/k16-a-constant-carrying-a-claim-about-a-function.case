labelled: 2026-09-22
--- code
import { Field, LedgerBook } from './book';

export const ACCRUAL_NAMESPACE = 'urn:ledger:accrual:2026';

export function findField(book: LedgerBook, name: string): Field | undefined {
  return book.fields.find((field) => field.namespace === ACCRUAL_NAMESPACE && field.name === name);
}
--- facts
A book may bind any prefix to the accrual namespace, so the field lookup matches by namespace.
