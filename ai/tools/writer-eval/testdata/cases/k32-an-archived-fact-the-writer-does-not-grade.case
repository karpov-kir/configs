labelled: 2026-09-24
--- code
const settlementPropertyOf: Record<PostingScheme, 'directCash' | 'escrowCredit'> = {
  [PostingScheme.DirectCash]: 'directCash',
  [PostingScheme.EscrowCredit]: 'escrowCredit',
};

export function withOnlyScheme(source: SourceConfig, scheme: PostingScheme): SourceConfig {
  const settlement = source.settlement;
  const measuredProperty = settlementPropertyOf[scheme];

  if (!settlement) {
    throw new Error(`Cannot measure ${scheme} against a source that configures no settlement`);
  }

  const measuredScheme = settlement[measuredProperty];

  if (!measuredScheme) {
    throw new Error(`Cannot measure ${scheme} against a source that does not configure it`);
  }

  return { ...source, settlement: { [measuredProperty]: { ...measuredScheme } } };
}
--- facts
The service prefers EscrowCredit ahead of DirectCash by default, so a source offering both never measures DirectCash.
