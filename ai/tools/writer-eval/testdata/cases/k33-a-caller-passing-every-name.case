labelled: 2026-09-24
--- code
export function listSchemeIds(name: string): string[] {
  return Object.prototype.hasOwnProperty.call(schemeIds, name)
    ? schemeIds[name as SchemeName]
    : [];
}
--- callers
// tests/helpers/SettlementHelper.ts
export function assertSettlement(config: SettlementConfig): void {
  for (const name of Object.keys(config)) {
    if (listSchemeIds(name).some(isSchemeAccepted)) {
      return;
    }
  }

  throw new SkipException('No settlement scheme is accepted here');
}
--- facts
`assertSettlement` passes every property name of a settlement configuration to `listSchemeIds`, `immediateSettlement` included.
