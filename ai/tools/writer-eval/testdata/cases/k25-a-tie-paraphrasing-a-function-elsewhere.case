labelled: 2026-09-22
--- code
const SUPPLEMENT_NAMESPACE = 'urn:ledger:supplement:2014';

export function attributeInNamespace(node: Element, name: string): string | null {
  return node.getAttributeNS(SUPPLEMENT_NAMESPACE, name);
}

export function formatOfEntry(node: Element): string | null {
  return node.getAttribute('format') ?? attributeInNamespace(node, 'supplementalFormats');
}
--- facts
A export may bind any prefix it likes to the supplement namespace.
An entry may name its format in the supplemental formats attribute.
