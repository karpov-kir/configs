--- code
export function toEntryArray(list: LivePostingList): Posting[] {
  return Array.from(list);
}
--- callers
// tests/helpers/ClosingBookHelper.ts
toEntryArray(book.reversals).forEach((reversal) => book.removeEntry(reversal));
--- facts
A live posting list stops listing an entry as soon as the book removes it.
