labelled: 2026-09-29
--- code
export async function getSettlementClaim(requirement: SettlementRequirement): Promise<LedgerClaim> {
  const legacy = () => askLegacyKeys(window.LegacyLedgerKeys, requirement);
  const standard = () => askStandardApi(requirement);
  const [first, second] = requirement.clearing === Clearing.Escrow ? [legacy, standard] : [standard, legacy];
  const claim = await first();
  return claim === LedgerClaim.Unknown ? second() : claim;
}
--- facts
On older ledgers `requestSettlementAccess` rejects escrow, so this function asks `window.LegacyLedgerKeys` first about an escrow requirement.
`window.LegacyLedgerKeys` supports escrow only, so this function asks the standard API first about any other clearing.
