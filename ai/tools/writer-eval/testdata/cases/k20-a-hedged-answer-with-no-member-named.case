labelled: 2026-09-22
--- code
export function getProbeFormatClaim(formatName: string): LedgerClaim {
  switch (probe.canPost(formatName)) {
    case 'accepted':
      return LedgerClaim.Accepted;
    case 'maybe':
      return LedgerClaim.Unknown;
    default:
      return LedgerClaim.Refused;
  }
}
--- facts
`canPost`, the probe's own format check, answers `maybe` where the ledger will not commit to a format.
