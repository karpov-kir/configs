--- code
export function soleEntryType(rows: LedgerRow[]): string | undefined {
  const types = new Set(rows.map((row) => row.entryType));
  return types.size === 1 ? [...types][0] : undefined;
}
--- facts
The poster switches between rows that declare one entry type. This function returns undefined where several declare it.
