--- code
export function listEntriesDeclaring(ledger: Document, entryType: string): EntryInBook[] {
  return listPricedEntries(ledger).filter(inBook => declaresEntryType(inBook, entryType));
}
--- facts
Lists every priced entry in the ledger that declares the given entry type.
