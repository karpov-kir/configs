#!/usr/bin/env bash
#USAGE arg "<direction>" help="encrypt, decrypt or rekey (re-encrypt for the keys now in .sops.yaml)"
#USAGE arg "<env>" help="The environment: the file is .env.<env> in the task's dir"
# One copy for every project: a project's mise.toml fetches this file at a pinned commit and gives it the dir of its
# env files. sops encrypts for the age public keys in .sops.yaml, and each person decrypts with their own key, so
# there is no shared password to mistype.
set -euo pipefail
[[ $usage_env =~ ^[a-z][a-z0-9-]*$ ]] || { echo "✕ env must be a lowercase name like production, got $usage_env" >&2; exit 2; }
file=.env.$usage_env
export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}
# A .new file left by Ctrl-C would hold plaintext secrets.
trap 'rm -f "$file.new" "$file.encrypted.new"' EXIT
umask 077
case "$usage_direction" in
  encrypt)
    # Into a temp file, moved in place only on success: a failed sops would leave a truncated file.
    # --filename-override picks the .sops.yaml rule by the encrypted file's name.
    sops encrypt --input-type dotenv --output-type dotenv --filename-override "$file.encrypted" "$file" > "$file.encrypted.new"
    mv "$file.encrypted.new" "$file.encrypted"
    ;;
  decrypt)
    # Into a temp file, moved in place only on success: a failure leaves the plaintext as it was.
    sops decrypt --input-type dotenv --output-type dotenv "$file.encrypted" > "$file.new" \
      || { echo "✕ $file did not decrypt: no key at $SOPS_AGE_KEY_FILE, or its public key is not in .sops.yaml for this file" >&2; exit 1; }
    mv "$file.new" "$file"
    ;;
  rekey)
    # updatekeys only changes who may open the file; rotate also replaces its data key, so a removed key cannot open
    # the new file. Values someone who left has seen still need changing by hand.
    sops updatekeys --yes --input-type dotenv "$file.encrypted"
    sops rotate -i --input-type dotenv --output-type dotenv "$file.encrypted"
    ;;
  *) echo "✕ direction must be encrypt, decrypt or rekey, got $usage_direction" >&2; exit 2 ;;
esac
