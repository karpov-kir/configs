// The rules come from @kk-forge/oxlint-config, and its README says what each file turns on. A package without Solid
// drops solid.json.
{
  "extends": [
    "./node_modules/@kk-forge/oxlint-config/base.json",
    "./node_modules/@kk-forge/oxlint-config/solid.json"
  ],
  "overrides": [
    {
      // Lets the logger write to the console. The base fails every other `console` call.
      "files": ["src/Logger.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
