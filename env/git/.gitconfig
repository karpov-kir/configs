# This is Git's per-user configuration file.

[user]
name = Kirill Karpov
email = karpov.kir.v@gmail.com

[push]
autoSetupRemote = true

[pull]
rebase = false

[includeIf "hasconfig:remote.*.url:git@github.com:karpov-kir/**"]
	path = ~/.gitconfig-kk-forge
[includeIf "hasconfig:remote.*.url:git@github.com:kk-forge-engineering/**"]
	path = ~/.gitconfig-kk-forge
[includeIf "hasconfig:remote.*.url:https://github.com/karpov-kir/**"]
	path = ~/.gitconfig-kk-forge
[includeIf "hasconfig:remote.*.url:https://github.com/kk-forge-engineering/**"]
	path = ~/.gitconfig-kk-forge
